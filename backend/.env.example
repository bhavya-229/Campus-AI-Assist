PROJECT_NAME="Campus AI Assist"
API_V1_STR="/api"
SECRET_KEY="campus_ai_assist_super_secret_jwt_key_for_development"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite; configure MySQL if preferred)
DATABASE_URL="sqlite:///./campus_ai.db"
# DATABASE_URL="mysql+pymysql://root:password@localhost:3306/campus_ai_db"

# Qdrant Vector DB (Embedded local storage)
QDRANT_PATH="./data/qdrant_storage"
QDRANT_COLLECTION_NAME="campus_knowledge_base"

# Local LLM & Ollama Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="llama3.2:3b"
OLLAMA_EMBED_MODEL="nomic-embed-text:latest"

# Optional Cloud LLMs
OPENAI_API_KEY=""
GEMINI_API_KEY=""
